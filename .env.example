VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — only needed for lesson-reminder push notifications. The public
# half of a VAPID keypair (`npx web-push generate-vapid-keys`); the private
# half is a Supabase Edge Function secret, never a frontend env var. See
# docs/architecture.md#lesson-reminders.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
